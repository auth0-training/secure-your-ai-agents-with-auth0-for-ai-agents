{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run MCP server",
      "type": "shell",
      "command": "npm run start",
      "options": {
        "cwd": "${workspaceFolder}/fastmcp-mcp-js-sample"
      },
      "group": "build",
      "presentation": { 
        "echo": true, 
        "reveal": "always", 
        "panel": "shared" 
      }
    },
    {
      "label": "Start MCP Inspector",
      "type": "shell",
      "command": "npx",
      "args": [
        "--yes",
        "@modelcontextprotocol/inspector@latest"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": true
      }
    }
  ]
}