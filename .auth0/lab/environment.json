{
  "name": "Lab: Secure Your AI Agents with Auth0 for AI Agents",
  "version": "2.0.0",
  "resources": "resources.yml",
  "unauthenticatedTour": ".auth0/lab/guides/01-intro.tour",
  "postConfigureTour": ".auth0/lab/guides/01-intro.tour",
  "clients": [
    {
      "name": "Z-Assistant",
      "directory": "z-assistant",
       "env": {
        "OPENAI_API_KEY": "YOUR_API_KEY",
        "AUTH0_SECRET": "use [openssl rand -hex 32] to generate a 32 bytes value",
        "APP_BASE_URL": "",
        "AUTH0_DOMAIN" : "$tenant_base_url",
        "AUTH0_CLIENT_ID": "$client_id",
        "AUTH0_CLIENT_SECRET" : "$client_secret",
        "RETAILZERO_API_URL": "http://localhost:3001",
        "RETAILZERO_API_AUDIENCE": "https://retailzero-api/"
      }
    }
  ]
}
